{
  "Complete-value codec": {
    "prefix": "codec",
    "description": "Declare and explicitly register a bounded media-type codec",
    "body": [
      "codec ${1:name} {",
      "    mediaType: \"${2:application/vnd.example.value}\"",
      "    encode(value) {",
      "        ${3:text.encode(value as string)}",
      "    }",
      "    decode(bytes) {",
      "        ${4:text.decode(bytes)}",
      "    }",
      "}",
      "use codec ${1:name}"
    ]
  },
  "Incremental codec": {
    "prefix": "codecstream",
    "description": "Decode byte sources into a stream of complete native records",
    "body": [
      "codec ${1:name} {",
      "    mediaType: \"${2:application/vnd.example.records}\"",
      "    encode(value) { text.encode(value as string) }",
      "    decode(input) {",
      "        stream {",
      "            for line in text.lines(input) {",
      "                yield line",
      "            }",
      "        }",
      "    }",
      "}",
      "use codec ${1:name}"
    ]
  },
  "Lazy byte producer": {
    "prefix": "source",
    "description": "Produce ordered UTF-8 strings or bytes on demand",
    "body": ["source {", "    for part in ${1:parts} {", "        yield part", "    }", "}"]
  },
  "Streamed HTTP response": {
    "prefix": "httpstream",
    "description": "Check response headers before streaming a download to a file",
    "body": ["response = http.get(\"${1:url}\", stream: true, maxResponseBytes: ${3:104857600})", "assert(response.status == 200)", "fs.write(\"${2:./download.bin}\", response.chunks)"]
  },
  "Documented flow": {
    "prefix": "flowdoc",
    "description": "Declare a flow with documentation and a parameter description",
    "body": [
      "/// ${1:Description.}",
      "/// @param ${2:value} ${3:Input description.}",
      "/// @returns ${4:Result description.}",
      "flow ${5:name}(${2:value}) = $2"
    ]
  },
  "Mettle declaration": {
    "prefix": "flow",
    "description": "Declare a reusable Mettle function",
    "body": [
      "flow ${1:name}(${2}) {",
      "    ${3:null}",
      "}"
    ]
  },
  "Expression-bodied flow": {
    "prefix": "flowexpr",
    "description": "Declare a concise reusable Mettle function",
    "body": [
      "flow ${1:name}(${2}) = ${3:http.get(\"/path\")}"
    ]
  },
  "Anonymous workflow": {
    "prefix": "flowblock",
    "description": "Declare an anonymous multi-operation flow",
    "body": [
      "flow {",
      "    ${1:return http.get(\"/path\")}",
      "}"
    ]
  },
  "Runnable main flow": {
    "prefix": "flowmain",
    "description": "Declare the program entry flow",
    "body": [
      "flow main {",
      "    ${1:null}",
      "}"
    ]
  },
  "Namespace declaration": {
    "prefix": "namespace",
    "description": "Declare this file's namespace and an optional dependency",
    "body": [
      "namespace ${1:name}",
      "use namespace ${2:core}"
    ]
  },
  "Assertion": {
    "prefix": "assert",
    "description": "Assert that an expression is true",
    "body": [
      "assert(${1:response.status == 200})"
    ]
  },
  "Terminal failure": {
    "prefix": "fail",
    "description": "Stop the current flow or test without retrying",
    "body": [
      "fail(\"${1:reason}\")"
    ]
  },
  "Echo report message": {
    "prefix": "echo",
    "description": "Record a value in the current flow or test report",
    "body": [
      "echo(\"${1:message}\")"
    ]
  },
  "Assertion with message": {
    "prefix": "assertm",
    "description": "Assert with a failure message",
    "body": [
      "assert(${1:response.status == 200}, \"${2:expected HTTP 200}\")"
    ]
  },
  "File test": {
    "prefix": "mettle-test",
    "description": "Declare a named test in this file",
    "body": [
      "test \"${1:name}\" {",
      "    assert(${2:true})",
      "}"
    ]
  },
  "Conditional": {
    "prefix": "if",
    "description": "Choose between flow or test statements",
    "body": [
      "if (${1:condition}) {",
      "    ${2:return value}",
      "} else {",
      "    ${3:return fallback}",
      "}"
    ]
  },
  "Anonymous file context": {
    "prefix": "usecontext",
    "description": "Apply a context to every flow and test in this file",
    "body": [
      "use context {",
      "    ${1:baseUrl}: env(\"${2:API_URL}\")",
      "}"
    ]
  },
  "Secret environment variable": {
    "prefix": "senv",
    "description": "Read a secret environment variable",
    "body": [
      "senv(\"${1:API_TOKEN}\")"
    ]
  },
  "Deadline scope": {
    "prefix": "within",
    "description": "Run a block within a deadline",
    "body": [
      "within(timeout: ${1:2s}) {",
      "    ${2:http.get(\"/path\")}",
      "}"
    ]
  },
  "Retry scope": {
    "prefix": "retry",
    "description": "Retry a failing block",
    "body": [
      "retry(attempts: ${1:3}, delay: ${2:50ms}) {",
      "    ${3:http.get(\"/path\")}",
      "}"
    ]
  },
  "Bounded parallel scope": {
    "prefix": "parallel",
    "description": "Run expressions concurrently with bounded fan-out",
    "body": [
      "parallel(limit: ${1:4}) {",
      "    ${2:http.get(\"/first\")}",
      "    ${3:http.get(\"/second\")}",
      "}"
    ]
  },
  "Rate workload": {
    "prefix": "rate",
    "description": "Start iterations at a fixed rate with bounded admission",
    "body": [
      "rate(target: ${1:100}, period: ${2:1s}, duration: ${3:30s}, limit: ${4:200}) {",
      "    ${5:http.get(\"/health\")}",
      "}"
    ]
  },
  "Fixed concurrency workload": {
    "prefix": "concurrency",
    "description": "Keep a fixed number of iterations active",
    "body": [
      "concurrency(limit: ${1:20}, duration: ${2:30s}) {",
      "    ${3:http.get(\"/health\")}",
      "}"
    ]
  },
  "HTTP context": {
    "prefix": "flowcontext",
    "description": "Declare an HTTP context",
    "body": [
      "context ${1:api} {",
      "    defaults http {",
      "        baseUrl: \"${2:https://jsonplaceholder.typicode.com}\"",
      "        timeout: ${3:5s}",
      "    }",
      "}"
    ]
  },
  "HTTP GET": {
    "prefix": "httpget",
    "description": "Send an HTTP GET request",
    "body": [
      "http.get(\"${1:https://jsonplaceholder.typicode.com/posts/1}\")"
    ]
  },
  "HTTP JSON POST": {
    "prefix": "httppost",
    "description": "Send an HTTP POST request with a JSON body",
    "body": [
      "http.post(\"${1:https://jsonplaceholder.typicode.com/posts}\", body: {",
      "    ${2:name}: ${3:\"value\"}",
      "})"
    ]
  },
  "HTTP request with text body": {
    "prefix": "httpbody",
    "description": "Send an HTTP request with a UTF-8 text body",
    "body": [
      "http.${1|post,put,patch,delete|}(\"${2:/path}\", body: \"${3:value}\")"
    ]
  },
  "For each": {
    "prefix": "forin",
    "description": "Iterate a finite array or object",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    ${3:echo(item)}",
      "}"
    ]
  },
  "Complete file read": {
    "prefix": "fsread",
    "description": "Read a bounded file as reusable bytes or UTF-8 text",
    "body": ["${1:payload} = fs.${2|read,readText|}(\"${3:./payload.txt}\")"]
  },
  "Incremental file copy": {
    "prefix": "fscopy",
    "description": "Copy an incremental source without buffering the whole file",
    "body": ["fs.write(\"${1:./copy.bin}\", fs.stream(\"${2:./payload.bin}\"))"]
  },
  "Streamed HTTP upload": {
    "prefix": "httpfile",
    "description": "Send a file progressively through an ordinary HTTP call",
    "body": ["response = http.post(\"${1:/upload}\", body: fs.stream(\"${2:./payload.bin}\"))"]
  },
  "Named parallel": {
    "prefix": "parallel-named",
    "description": "Run labeled branches concurrently",
    "body": [
      "parallel {",
      "    ${1:first}: ${2:http.get(\"/first\")}",
      "    ${3:second}: ${4:http.get(\"/second\")}",
      "}"
    ]
  },
  "JSON codec round trip": {
    "prefix": "jsoncodec",
    "description": "Encode a value as bytes and decode it explicitly",
    "body": ["encoded = json.encode(${1:value})", "decoded = json.decode(encoded)"]
  },
  "Built-in value kind check": {
    "prefix": "iskind",
    "description": "Check an actual built-in value kind",
    "body": ["${1:value} is ${2|number,integer,string,boolean,null,bytes,duration,array,object,source|}"]
  },
  "HTTP explicit media type": {
    "prefix": "httpmedia",
    "description": "Select the content representation through a codec constant",
    "body": ["http.post(\"${1:/path}\", body: ${2:value}, mediaType: ${3|json,text,bytes|}.mediaType)"]
  }
}
